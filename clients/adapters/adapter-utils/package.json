{
  "name": "@polar-sh/adapter-utils",
  "version": "0.4.7",
  "description": "Core package for Polar adapters",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --outDir dist",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm format:check && eslint --max-warnings 0 .",
    "test": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@polar-sh/sdk": "^0.47.0"
  },
  "devDependencies": {
    "@polar-sh/eslint-config": "workspace:*",
    "@sindresorhus/tsconfig": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
