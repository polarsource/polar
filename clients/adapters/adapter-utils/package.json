{
  "name": "@polar-sh/adapter-utils",
  "version": "0.4.7",
  "description": "Core package for Polar adapters",
  "repository": {
    "type": "git",
    "url": "https://github.com/polarsource/polar.git",
    "directory": "clients/adapters/adapter-utils"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --outDir dist",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@polar-sh/sdk": "1.0.0-alpha.20"
  },
  "devDependencies": {
    "@polar-sh/typescript-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
