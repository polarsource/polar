{
  "name": "@polar-sh/better-auth",
  "version": "2.0.0",
  "description": "Polar integration for better-auth",
  "repository": {
    "type": "git",
    "url": "https://github.com/polarsource/polar.git",
    "directory": "clients/adapters/better-auth"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsup ./src/index.ts ./src/client.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "npm run build -- --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "polar",
    "better-auth",
    "payments",
    "subscriptions"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@polar-sh/sdk": "1.0.0-alpha.22",
    "@polar-sh/typescript-config": "workspace:*",
    "@types/node": "^22.20.4",
    "@typescript/native": "catalog:",
    "better-auth": "^1.7.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@polar-sh/sdk": "1.0.0-alpha.22",
    "better-auth": "^1.7.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "dependencies": {
    "@polar-sh/adapter-utils": "workspace:*",
    "@polar-sh/checkout": "workspace:*"
  }
}
