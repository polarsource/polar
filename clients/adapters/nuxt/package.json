{
  "name": "@polar-sh/nuxt",
  "version": "0.6.0",
  "description": "Polar.sh integration for Nuxt",
  "repository": {
    "type": "git",
    "url": "https://github.com/polarsource/polar.git",
    "directory": "clients/adapters/nuxt"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepare": "nuxt-module-build prepare",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "typecheck": "nuxi prepare playground && pnpm test:types"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "@polar-sh/adapter-utils": "workspace:*",
    "@polar-sh/sdk": "1.0.0-alpha.22"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.2",
    "@types/node": "latest",
    "nuxt": "^4.5.2",
    "typescript": "6.0.3",
    "vitest": "catalog:",
    "vue-tsc": "3.3.11",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  }
}
