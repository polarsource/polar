{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../packages/oxlint-config/oxlint-react-doctor.json"],
  "plugins": ["import", "react"],
  "jsPlugins": [
    {
      "name": "expo",
      "specifier": "./oxlint-plugins/expo.js"
    },
    {
      "name": "@polar",
      "specifier": "./oxlint-plugins/index.js"
    }
  ],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "commonjs": true,
    "es2022": true,
    "node": true
  },
  "ignorePatterns": ["android/app/build", "dist/*"],
  "rules": {
    "import/export": "error",
    "import/named": "error",
    "import/namespace": "error",
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",
    "import/no-duplicates": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-dupe-class-members": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty-character-class": "warn",
    "no-empty-pattern": "warn",
    "no-extend-native": "warn",
    "no-extra-bind": "warn",
    "no-redeclare": "warn",
    "no-undef": "error",
    "no-unreachable": "warn",
    "no-unsafe-negation": "warn",
    "no-unused-expressions": [
      "warn",
      {
        "allowShortCircuit": true,
        "enforceForJSX": true
      }
    ],
    "no-unused-labels": "warn",
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "args": "none",
        "ignoreRestSiblings": true,
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-with": "warn",
    "unicode-bom": ["warn", "never"],
    "use-isnan": "error",
    "valid-typeof": "error",
    "import/first": "warn",
    "no-var": "error",
    "react/error-boundaries": "error",
    "react/globals": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/unsupported-syntax": "error",
    "react/void-use-memo": "error",
    "react/display-name": "error",
    "react/jsx-key": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-danger-with-children": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-is-mounted": "error",
    "react/no-render-return-value": "error",
    "react/require-render-return": "error",
    "react/no-string-refs": "error",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "warn",
    "react/no-this-in-sfc": "warn",
    "expo/use-dom-exports": ["error"],
    "expo/no-env-var-destructuring": ["error"],
    "expo/no-dynamic-env-var": ["error"],
    "@polar/no-view": "error",
    "@polar/no-text": "error",
    "@polar/no-stylesheet-create": "error",
    "@polar/no-image": "error",
    "@polar/no-flatlist": "error",
    "@polar/no-touchable": "error",
    "@polar/no-jsx-logical-and": "error",
    "@polar/no-restyle-use-theme": "error",
    "@polar/no-hardcoded-spacing": "error",
    "@polar/no-hardcoded-colors": "error",
    "@polar/no-hardcoded-dimensions": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react-doctor/expo-no-non-inlined-env": "warn",
    "react-doctor/rn-animation-reaction-as-derived": "warn",
    "react-doctor/rn-bottom-sheet-no-ignored-scroll-prop": "warn",
    "react-doctor/rn-bottom-sheet-no-state-in-on-animate": "warn",
    "react-doctor/rn-bottom-sheet-use-integrated-scrollable": "warn",
    "react-doctor/rn-detox-missing-await": "warn",
    "react-doctor/rn-list-callback-per-row": "warn",
    "react-doctor/rn-list-data-mapped": "warn",
    "react-doctor/rn-list-recyclable-without-types": "warn",
    "react-doctor/rn-no-deep-imports": "warn",
    "react-doctor/rn-no-deprecated-modules": "error",
    "react-doctor/rn-no-dimensions-get": "warn",
    "react-doctor/rn-no-falsy-and-render": "error",
    "react-doctor/rn-no-image-children": "error",
    "react-doctor/rn-no-legacy-expo-packages": "warn",
    "react-doctor/rn-no-raw-text": "error",
    "react-doctor/rn-no-scroll-state": "error",
    "react-doctor/rn-no-scrollview-mapped-list": "warn",
    "react-doctor/rn-platform-shaking-use-direct-import": "warn",
    "react-doctor/rn-prefer-pressable-over-gesture-detector": "warn",
    "react-doctor/rn-pressable-shared-value-mutation": "warn",
    "react-doctor/rn-reanimated-4-no-legacy-spring-thresholds": "warn",
    "react-doctor/rn-reanimated-4-no-removed-api": "warn",
    "react-doctor/rn-style-prefer-boxshadow": "warn",
    // 7 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/rn-list-missing-estimated-item-size": "off",
    // 7 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/rn-no-inline-flatlist-renderitem": "off",
    // 5 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/rn-no-inline-object-in-list-item": "off",
    // 1 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/rn-no-legacy-shadow-styles": "off",
    // 1 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/rn-no-renderitem-key": "off",
    // 6 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/rn-reanimated-4-use-worklets-scheduler": "off",
    // 16 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/rn-scrollview-dynamic-padding": "off",
    // 1 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/rn-scrollview-flex-in-content-container": "off",
    // 173 findings 2026-10-27, memoization rule, the Expo app does not run the React Compiler
    "react-doctor/jsx-no-new-object-as-prop": "off",
    // 101 findings 2026-10-27, memoization rule, the Expo app does not run the React Compiler
    "react-doctor/jsx-no-new-function-as-prop": "off",
    // 30 findings 2026-10-27, memoization rule, the Expo app does not run the React Compiler
    "react-doctor/jsx-no-new-array-as-prop": "off",
    // 29 findings 2026-10-27, memoization rule, the Expo app does not run the React Compiler
    "react-doctor/jsx-no-jsx-as-prop": "off",
    // 6 findings 2026-10-27, memoization rule, the Expo app does not run the React Compiler
    "react-doctor/jsx-no-constructed-context-values": "off",
    // 13 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/no-unstable-nested-components": "off",
    // 9 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/only-export-components": "off",
    // 2 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/query-mutation-missing-invalidation": "off",
    // 2 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/context-provider-value-from-unmemoized-local-literal": "off",
    // 1 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/no-autofocus": "off",
    // 1 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/no-array-index-as-key": "off",
    // 1 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/no-giant-component": "off",
    // 1 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/async-await-in-loop": "off",
    // 1 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/js-set-map-lookups": "off",
    // 1 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/no-spread-accumulator-in-reduce": "off"
  },
  "overrides": [
    {
      "files": [
        "app/**/subscriptions/**/cancel/index.tsx",
        "app/**/subscriptions/**/update/index.tsx",
        "app/**/onboarding/index.tsx"
      ],
      "rules": {
        "react/incompatible-library": "off"
      }
    },
    {
      "files": ["app/**/checkout-links/**/index.tsx"],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    },
    {
      "files": [
        "components/Animations/**/*.tsx",
        "components/Home/RevenueTile.tsx",
        "components/Shared/PlaceholderBox.tsx",
        "components/Shared/SlideToAction.tsx",
        "components/Shared/Toast.tsx"
      ],
      "rules": {
        "react/immutability": "off"
      }
    },
    {
      "files": ["**/metro.config.js"],
      "globals": {
        "AsyncDisposableStack": "readonly",
        "DisposableStack": "readonly",
        "SuppressedError": "readonly"
      },
      "env": {
        "node": true
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
      "rules": {
        "no-undef": "off",
        "no-unused-vars": [
          "warn",
          {
            "vars": "all",
            "args": "none",
            "ignoreRestSiblings": true,
            "caughtErrors": "all"
          }
        ],
        "no-useless-constructor": "warn",
        "typescript/array-type": [
          "warn",
          {
            "default": "array"
          }
        ],
        "typescript/no-empty-object-type": "warn",
        "typescript/no-wrapper-object-types": "warn",
        "typescript/consistent-type-assertions": [
          "warn",
          {
            "assertionStyle": "as",
            "objectLiteralTypeAssertions": "allow"
          }
        ],
        "typescript/no-extra-non-null-assertion": "warn",
        "typescript/no-require-imports": [
          "warn",
          {
            "allow": [
              "\\.(aac|aiff|avif|bmp|caf|db|gif|heic|html|jpeg|jpg|json|m4a|m4v|mov|mp3|mp4|mpeg|mpg|otf|pdf|png|psd|svg|ttf|wav|webm|webp|xml|yaml|yml|zip)$"
            ]
          }
        ]
      },
      "plugins": ["typescript"]
    },
    {
      "files": ["tooling/**/*.js"],
      "rules": {
        "no-console": "off"
      },
      "globals": {
        "process": "readonly",
        "console": "readonly",
        "require": "readonly",
        "module": "writable",
        "__dirname": "readonly"
      }
    }
  ]
}
