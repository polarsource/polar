{
  "cli": {
    "version": ">= 16.2.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.1"
      },
      "channel": "simulator",
      "extends": "development"
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
