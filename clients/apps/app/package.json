{
  "name": "@polar-sh/app",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "pnpm test:oxlint-plugins && jest",
    "test:oxlint-plugins": "for file in oxlint-plugins/*.rule-test.cjs; do node \"$file\"; done",
    "test:watch": "pnpm test:oxlint-plugins && jest --watchAll",
    "ota": "node tooling/ota-preflight",
    "build:production": "pnpm dlx eas-cli build --platform all --profile production",
    "build:development": "pnpm dlx eas-cli build --platform all --profile development",
    "build:simulator": "pnpm dlx eas-cli build --platform all --profile simulator",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "push:test": "node tooling/push-notifications/send-push.js",
    "postinstall": "pnpm --filter @polar-sh/client build && patch-package",
    "prewidget": "EXPO_NO_GIT_STATUS=1 EXPO_WIDGET_BUILD=1 pnpm exec expo prebuild --template ./node_modules/@bacons/apple-targets/prebuild-blank.tgz --clean",
    "eas-build-pre-install": "test -f ../../pnpm-workspace.yaml || printf 'packages:\\n  - apps/*\\n  - packages/*\\n  - examples/*\\n' > ../../pnpm-workspace.yaml"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@bacons/apple-targets": "^3.0.6",
    "@dev-plugins/react-navigation": "^0.3.1",
    "@dev-plugins/react-query": "^0.1.0",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "57.0.19",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@polar-sh/client": "workspace:*",
    "@polar-sh/currency": "workspace:^",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/cli": "latest",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/native": "^7.1.25",
    "@sentry/react-native": "^7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@shopify/restyle": "^2.4.5",
    "@tanstack/react-query": "^5.90.12",
    "date-fns": "catalog:",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-insights": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "^57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.1",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.68.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "slugify": "^1.6.6",
    "tailwindcss": "^3.4.19",
    "victory-native": "^41.20.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@sentry/cli": "^2.58.4",
    "@types/jest": "^29.5.14",
    "@types/react": "19.2.3",
    "@types/react-test-renderer": "^19.3.0",
    "@typescript/native": "catalog:",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "catalog:"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
