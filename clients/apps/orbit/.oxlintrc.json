{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../packages/oxlint-config/oxlint-next.json"],
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "babel.config.js",
    "scripts/**"
  ],
  "settings": {
    "react-doctor": {
      "capabilities": [
        "nextjs",
        "nextjs:15",
        "react",
        "react-compiler",
        "react:19",
        "react:19.2",
        "ssr"
      ],
      "onlyExportComponents": {
        "allowExportNames": [
          "metadata",
          "generateMetadata",
          "viewport",
          "generateViewport",
          "dynamic",
          "dynamicParams",
          "revalidate",
          "fetchCache",
          "runtime",
          "preferredRegion",
          "maxDuration",
          "generateStaticParams",
          "generateSitemaps",
          "generateImageMetadata"
        ]
      }
    }
  },
  "rules": {
    // 3 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/only-export-components": "off",
    // 2 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/anchor-is-valid": "off",
    // 2 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/no-prevent-default": "off",
    // 1 findings 2026-10-27, re-enable in a follow-up
    "react-doctor/js-hoist-intl": "off"
  }
}
