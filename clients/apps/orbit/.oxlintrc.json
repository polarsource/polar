{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../packages/oxlint-config/oxlint-next.json"],
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "babel.config.js",
    "scripts/**"
  ],
  "settings": {
    "react-doctor": {
      "capabilities": [
        "nextjs",
        "nextjs:15",
        "react",
        "react-compiler",
        "react:19",
        "react:19.2",
        "ssr"
      ]
    }
  }
}
