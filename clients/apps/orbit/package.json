    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@polar-sh/typescript-config": "workspace:*",
    "@stylexjs/babel-plugin": "catalog:",
    "@stylexjs/postcss-plugin": "catalog:",
    "@tailwindcss/forms": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "^22.20.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
