{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-aup": "cp \"src/app/(main)/(website)/(landing)/(mdx)/legal/acceptable-use-policy/page.mdx\" \"src/app/(main)/onboarding/validate-description/acceptable-use-policy.mdx\"",
    "prebuild": "pnpm copy-aup",
    "dev": "pnpm copy-aup && next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "format": "oxfmt ./src",
    "format:check": "oxfmt --check ./src",
    "lint:changed": "oxlint --type-aware $(git diff --name-only --relative --diff-filter=ACMR HEAD | grep -E '\\.(cjs|js|jsx|mjs|ts|tsx)$')",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:headed": "E2E_HEADED=1 vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "=24"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
