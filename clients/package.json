{
  "private": true,
  "name": "polar",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev",
    "dev-web": "turbo run dev --filter=web",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate": "pnpm -C packages/client generate",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "box-codemod": "pnpm --filter @polar-sh/box-codemod box-codemod",
    "preinstall": "npx only-allow pnpm",
    "prepare": "pnpm --filter polar-cli exec effect-tsgo patch && turbo run build --filter='./packages/*'",
    "release-packages": "turbo run build test --filter='./packages/*' --filter='./adapters/*' --filter='!polar-cli' && turbo run lint --filter='!polar-cli' && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@manypkg/cli": "^0.25.1",
    "knip": "^5.88.1",
    "only-allow": "1.2.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "turbo": "^2.11.2",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@types/react-dom": "19.3.0",
      "@types/react": "19.3.0",
      "@xmldom/xmldom@<0.8.12": ">=0.8.12",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "@xmldom/xmldom@>=0.7.0 <=0.8.13": ">=0.8.14",
      "@xmldom/xmldom@>=0.7.0 <=0.8.14": ">=0.8.15",
      "decode-uri-component@<=0.4.2": ">=0.5.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "nuxi": "3.28.0",
      "uuid@<11.1.1": ">=11.1.1",
      "webpack@>=5.49.0 <=5.104.0": ">=5.104.1",
      "webpack@>=5.49.0 <5.104.0": ">=5.104.0"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "manypkg": {
    "ignoredRules": [
      "INTERNAL_MISMATCH"
    ]
  }
}
