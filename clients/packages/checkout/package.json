{
  "name": "@polar-sh/checkout",
  "description": "Polar Checkout SDK",
  "author": "Polar",
  "license": "Apache-2.0",
  "type": "module",
  "version": "0.4.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/polarsource/polar.git",
    "directory": "clients/packages/checkout"
  },
  "scripts": {
    "build": "rm -rf dist/ && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./guards": {
      "types": "./dist/guards.d.ts",
      "default": "./src/guards.ts"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./payment-method": {
      "types": "./dist/payment-method.d.ts",
      "default": "./dist/payment-method.js"
    },
    "./react/payment-method": {
      "types": "./dist/react/payment-method.d.ts",
      "default": "./dist/react/payment-method.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./src/components/index.ts"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./src/hooks/index.ts"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./src/providers/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./guards": {
        "types": "./dist/guards.d.ts",
        "default": "./dist/guards.js"
      },
      "./embed": {
        "types": "./dist/embed.d.ts",
        "default": "./dist/embed.js"
      },
      "./payment-method": {
        "types": "./dist/payment-method.d.ts",
        "default": "./dist/payment-method.js"
      },
      "./react/payment-method": {
        "types": "./dist/react/payment-method.d.ts",
        "default": "./dist/react/payment-method.js"
      },
      "./components": {
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.js"
      },
      "./hooks": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.js"
      },
      "./providers": {
        "types": "./dist/providers/index.d.ts",
        "default": "./dist/providers/index.js"
      }
    }
  },
  "devDependencies": {
    "@polar-sh/typescript-config": "workspace:*",
    "@radix-ui/react-checkbox": "catalog:",
    "@radix-ui/react-select": "catalog:",
    "@stripe/react-stripe-js": "catalog:",
    "@stripe/stripe-js": "catalog:",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "^19.2.5",
    "terser": "^5.46.1",
    "tsup": "catalog:",
    "typescript": "latest",
    "vitest": "catalog:",
    "@polar-sh/currency": "workspace:^",
    "@polar-sh/client": "workspace:*",
    "@polar-sh/i18n": "workspace:*",
    "@polar-sh/ui": "workspace:^",
    "date-fns": "catalog:",
    "event-source-plus": "catalog:",
    "eventemitter3": "catalog:",
    "markdown-to-jsx": "catalog:",
    "react-hook-form": "catalog:"
  },
  "dependencies": {
    "date-fns": "catalog:"
  },
  "peerDependencies": {
    "@stripe/react-stripe-js": "^3.6.0 || ^4.0.2 || ^5.6.1",
    "@stripe/stripe-js": "^7.1.0 || ^8.11.0",
    "react": "^18 || ^19"
  }
}
