{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["node_modules/**", "dist/**", "bin/**"],
  "extends": ["../oxlint-config/oxlint-base.json"],
  "plugins": ["typescript", "import", "unicorn"],
  "jsPlugins": ["./lint/polar.js"],
  "rules": {
    "import/no-cycle": "error",
    "unicorn/no-process-exit": "error",
    "polar-cli/command-boundaries": "error",
    "polar-cli/command-descriptions": "error",
    "polar-cli/commands-only": "error",
    "polar-cli/no-ansi-escapes": "error",
    "polar-cli/no-effect-run-outside-entrypoint": "error",
    "polar-cli/no-hardcoded-hosts": "error",
    "polar-cli/no-process-env": "error",
    "polar-cli/schemas-are-pure": "error",
    "polar-cli/service-facade": "error",
    "polar-cli/service-boundaries": "error",
    "polar-cli/test-colocation": "error",
    "polar-cli/utils-boundaries": "error",
    "no-console": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "polar-cli/no-effect-run-outside-entrypoint": "off",
        "no-console": "off"
      }
    }
  ]
}
