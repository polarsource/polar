{
  "name": "@polar-sh/cli",
  "private": true,
  "version": "2.0.2",
  "description": "",
  "bin": "bin/cli.js",
  "type": "module",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "generate": "pnpm --dir ../../../sdk/cli-commands generate && pnpm --dir ../.. install --filter @polar-sh/cli --ignore-scripts --frozen-lockfile",
    "build": "tsup ./src/cli.ts --format esm --outDir bin",
    "docs:generate": "bun scripts/docs.ts",
    "docs:check": "bun scripts/docs.ts --check",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run --coverage",
    "check": "pnpm format:check && pnpm lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "build:binary": "bun build ./src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile polar",
    "build:binary:darwin-arm64": "bun build ./src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-darwin-arm64 --outfile polar",
    "build:binary:darwin-x64": "bun build ./src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-darwin-x64 --outfile polar",
    "build:binary:linux-x64": "bun build ./src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-linux-x64 --outfile polar",
    "build:binary:linux-arm64": "bun build ./src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-linux-arm64 --outfile polar",
    "build:binary:windows-x64": "bun build ./src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-windows-x64 --outfile polar",
    "npm:package": "bun scripts/npm-package.ts",
    "npm:publish": "bun scripts/npm-publish.ts"
  },
  "files": [
    "bin",
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.117",
    "@napi-rs/keyring": "2.1.0",
    "@polar-sh/cli-commands": "file:../../../sdk/cli-commands",
    "@polar-sh/sdk": "1.0.2",
    "effect": "4.0.0-rc.117",
    "open": "^10.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@sindresorhus/tsconfig": "^8.1.0",
    "@types/bun": "^1.4.2",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "^5.0.1",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
