{
  "name": "@polar-sh/client",
  "description": "Polar Internal API Client",
  "author": "Polar",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "uv run --directory ../../../server/ -m scripts.generate_openapi generate 2026-10 > ./src/openapi.json && openapi-typescript ./src/openapi.json --enum-values -o ./src/v1.ts && oxfmt ./src && pnpm run build",
    "build": "rm -rf dist/ && tsup",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./src/openapi.json"
  },
  "devDependencies": {
    "@polar-sh/typescript-config": "workspace:*",
    "@typescript/native": "catalog:",
    "openapi-typescript": "^7.13.0",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "date-fns": "catalog:",
    "openapi-fetch": "^0.15.0",
    "openapi-typescript-helpers": "^0.0.15"
  }
}
