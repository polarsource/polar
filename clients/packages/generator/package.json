{
  "name": "@polar-sh/generator",
  "description": "Polar Generator",
  "author": "Polar",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/polarsource/polar.git",
    "directory": "clients/packages/generator"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@polar-sh/typescript-config": "workspace:*",
    "@typescript/native": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
