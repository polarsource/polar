{
  "name": "@polar-sh/ingestion",
  "version": "0.4.2",
  "description": "Core package for Polar ingestion",
  "repository": {
    "type": "git",
    "url": "https://github.com/polarsource/polar.git",
    "directory": "clients/packages/ingestion"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "require": "./dist/index.cjs"
      }
    },
    "./strategies/Stream": {
      "import": {
        "types": "./dist/strategies/Stream/index.d.ts",
        "import": "./dist/strategies/Stream/index.js"
      },
      "require": {
        "types": "./dist/strategies/Stream/index.d.cts",
        "require": "./dist/strategies/Stream/index.cjs"
      }
    },
    "./strategies/LLM": {
      "import": {
        "types": "./dist/strategies/LLM/index.d.ts",
        "import": "./dist/strategies/LLM/index.js"
      },
      "require": {
        "types": "./dist/strategies/LLM/index.d.cts",
        "require": "./dist/strategies/LLM/index.cjs"
      }
    },
    "./strategies/S3": {
      "import": {
        "types": "./dist/strategies/S3/index.d.ts",
        "import": "./dist/strategies/S3/index.js"
      },
      "require": {
        "types": "./dist/strategies/S3/index.d.cts",
        "require": "./dist/strategies/S3/index.cjs"
      }
    },
    "./strategies/DeltaTime": {
      "import": {
        "types": "./dist/strategies/DeltaTime/index.d.ts",
        "import": "./dist/strategies/DeltaTime/index.js"
      },
      "require": {
        "types": "./dist/strategies/DeltaTime/index.d.cts",
        "require": "./dist/strategies/DeltaTime/index.cjs"
      }
    },
    "./opentelemetry": {
      "import": {
        "types": "./dist/opentelemetry/index.d.ts",
        "import": "./dist/opentelemetry/index.js"
      },
      "require": {
        "types": "./dist/opentelemetry/index.d.cts",
        "require": "./dist/opentelemetry/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentelemetry/core": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.744.0",
    "@polar-sh/sdk": "^1.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@polar-sh/sdk": "1.3.1",
    "@polar-sh/typescript-config": "workspace:*",
    "@tanstack/ai": "1.8.0",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "ai": "catalog:",
    "openai": "7.62.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
