{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["node_modules/**", "dist/**"],
  "extends": ["../oxlint-config/oxlint-react.json"],
  "overrides": [
    {
      "files": ["src/icons/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "settings": {
    "react-doctor": {
      "capabilities": [
        "radix-ui",
        "react",
        "react-compiler",
        "react:19",
        "react:19.2",
        "ssr",
        "tanstack-table"
      ]
    }
  }
}
