{
  "version": 4,
  "events": [
    {
      "name": "llm.completion"
    },
    {
      "name": "sandbox.stopped"
    },
    {
      "name": "tool.call"
    }
  ],
  "reducers": [
    {
      "slug": "input_tokens",
      "filter": {
        "conjunction": "and",
        "clauses": [
          {
            "property": "name",
            "operator": "eq",
            "value": "llm.completion"
          }
        ]
      },
      "aggregation": {
        "func": "sum",
        "property": "input_tokens"
      }
    },
    {
      "slug": "output_tokens",
      "filter": {
        "conjunction": "and",
        "clauses": [
          {
            "property": "name",
            "operator": "eq",
            "value": "llm.completion"
          }
        ]
      },
      "aggregation": {
        "func": "sum",
        "property": "output_tokens"
      }
    },
    {
      "slug": "sandbox_minutes",
      "filter": {
        "conjunction": "and",
        "clauses": [
          {
            "property": "name",
            "operator": "eq",
            "value": "sandbox.stopped"
          }
        ]
      },
      "aggregation": {
        "func": "sum",
        "property": "minutes"
      }
    },
    {
      "slug": "tool_calls",
      "filter": {
        "conjunction": "and",
        "clauses": [
          {
            "property": "name",
            "operator": "eq",
            "value": "tool.call"
          }
        ]
      },
      "aggregation": {
        "func": "count"
      }
    }
  ],
  "meters": [
    {
      "slug": "input_tokens",
      "reducer": "input_tokens",
      "unit_amount": 0.00015,
      "currency": "usd"
    },
    {
      "slug": "output_tokens",
      "reducer": "output_tokens",
      "unit_amount": 0.0008,
      "currency": "usd"
    },
    {
      "slug": "sandbox_minutes",
      "reducer": "sandbox_minutes",
      "unit_amount": 0.02,
      "currency": "usd"
    },
    {
      "slug": "tool_calls",
      "reducer": "tool_calls",
      "unit_amount": 0.04,
      "currency": "usd"
    }
  ],
  "entitlements": [
