[Unit]
Description=OpenCode 2 server for the Polar workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/polar
Environment=HOME=/root
ExecStart=/bin/opencode2 serve --service
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
