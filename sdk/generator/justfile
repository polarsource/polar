# https://just.systems

install:
    uv sync --all-extras

lint:
    uv run ruff format .
    uv run ruff check --fix .
    uv run ty check .

lint-check:
    uv run ruff format --check .
    uv run ruff check .
    uv run ty check .

test:
    uv run pytest tests/

openapi:
  uv run -m cli openapi

generate language:
  uv run -m cli generate openapi/* ../{{language}} --language {{language}} --clear

generate-cli:
  uv run -m cli generate openapi/2026-10.openapi.json ../cli-commands --language cli

generate-all:
  uv run -m cli generate openapi/* ../python --language python --clear
  uv run -m cli generate openapi/* ../typescript --language typescript --clear

docs-openapi:
  uv run -m cli docs-openapi openapi/*

release version:
  uv run -m cli release {{version}}
