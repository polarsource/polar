{
  "name": "react-email-pkg",
  "version": "1.0.0",
  "private": true,
  "readme": "README.md",
  "main": "dist/index.global.js",
  "bin": "dist/index.global.js",
  "scripts": {
    "dev": "email dev --dir src/emails",
    "clean": "rm -rf dist bin",
    "types": "uv --directory .. run python -m polar.email.schemas | openapi-typescript --output src/types/openapi.ts && oxfmt src/types/openapi.ts",
    "build": "pnpm run clean && tsup && pkg package.json",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src",
    "lint": "oxfmt --check src && oxlint ."
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "commander": "^15.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.5"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.5",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@yao-pkg/pkg": "^6.22.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.68.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "oxlint": "^1.83.0",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "pkg": {
    "targets": [
      "host"
    ],
    "outputPath": "bin"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
