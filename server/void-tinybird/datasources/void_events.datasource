SCHEMA >
    id UUID `json:$.id`,
    ingested_at DateTime64(3) `json:$.ingested_at`,
    timestamp DateTime64(3) `json:$.timestamp`,
    name LowCardinality(String) `json:$.name`,
    source LowCardinality(String) `json:$.source`,
    organization_id UUID `json:$.organization_id`,
    external_id String `json:$.external_id`,
    external_identity_id Nullable(String) `json:$.external_identity_id`,
    external_root_id Nullable(String) `json:$.external_root_id`,
    metadata String `json:$.metadata`

ENGINE "ReplacingMergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(timestamp)"
ENGINE_SORTING_KEY "organization_id, timestamp, id"

INDEXES >
    idx_external_id external_id TYPE bloom_filter GRANULARITY 1
