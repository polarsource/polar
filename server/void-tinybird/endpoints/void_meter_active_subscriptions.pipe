NODE active
SQL >
    %
    SELECT
        JSONExtractString(metadata, 'meter_id') AS meter_id,
        external_identity_id,
        argMax(name, (timestamp, ingested_at, id)) AS latest
    FROM void_events FINAL
    WHERE organization_id = toUUIDOrZero(
        {{String(organization_id, required=True)}}
    )
    AND name IN (
        'subscription.created',
        'subscription.updated',
        'subscription.canceled',
        'subscription.cycled',
        'subscription.revoked'
    )
    AND external_identity_id IS NOT NULL
    -- A cancel at period end is stamped at the boundary; it
    -- keeps the pair active until that moment passes.
    AND timestamp <= now()
    GROUP BY meter_id, external_identity_id
    HAVING latest NOT IN (
        'subscription.canceled', 'subscription.revoked'
    )

TYPE endpoint
