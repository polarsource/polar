NODE changes
SQL >
    %
    SELECT
        external_identity_id, name, external_id, timestamp, metadata
    FROM void_events FINAL
    WHERE organization_id = toUUIDOrZero(
        {{String(organization_id, required=True)}}
    )
    AND name IN (
        'subscription.created',
        'subscription.updated',
        'subscription.canceled',
        'subscription.cycled',
        'subscription.revoked',
        'meter.cycled'
    )
    AND (name != 'meter.cycled' OR source = 'system')
    AND external_identity_id IN JSONExtract(
        {{String(external_identity_ids, required=True)}},
        'Array(String)'
    )
    AND JSONExtractString(metadata, 'meter_id') = {{String(
        meter_id, required=True
    )}}
    AND timestamp >= {{DateTime(start, required=True)}}
    AND timestamp <= {{DateTime(end, required=True)}}
    ORDER BY timestamp, ingested_at, id

TYPE endpoint
